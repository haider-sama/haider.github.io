---
import "@/styles/global.css";

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import BlogMeta from "@/components/blog/BlogMeta.astro";
import CommentSection from "@/components/blog/CommentSection";

interface Props {
    slug: string;
    title: string;
    description: string;
    author: string;
    category: string;
    publishDate: Date;
    image?: string;
    readingTime: number;
}

const {
    slug,
    title,
    description,
    author,
    category,
    publishDate,
    image,
    readingTime,
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <meta
            name="keywords"
            content=`web development, website design, responsive websites, business websites, 
            SEO websites, web agency, custom websites, mechatronics, engine development, full
            stack engineer, AI/ML engineer`
        />
        <meta name="author" content="Haider Ali" />
        <meta name="robots" content="index, follow" />
        <meta name="theme-color" content="#ffffff" />

        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={Astro.url.href} />
        <meta property="og:site_name" content="Y3D Technologies" />
        <meta property="og:image" content="/og-image.jpg" />

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <link rel="canonical" href={Astro.url.href} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

        <title>{title} | Haider-sama</title>
    </head>

    <body class="min-h-screen flex flex-col bg-primary">
        <div
            class="mx-auto flex w-full max-w-4xl flex-1 flex-col border-x border-b
            border-gray-400 bg-gray-100"
        >
            <Header />

            <main class="flex-1">
                <article class="mx-auto px-8 py-16">
                    <h1 class="text-center text-4xl font-bold tracking-tight">
                        {title}
                    </h1>

                    <BlogMeta
                        author={author}
                        category={category}
                        publishDate={publishDate}
                        readingTime={readingTime}
                    />

                    {
                        image && (
                            <img
                                src={image}
                                alt={title}
                                class="my-8 aspect-[16/9] w-full rounded-lg object-cover"
                            />
                        )
                    }

                    <div class="blog-content">
                        <slot />
                    </div>
                </article>

                <CommentSection client:load slug={slug} />
            </main>
        </div>

        <Footer />
    </body>
</html>
