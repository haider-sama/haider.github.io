---
import "@/styles/global.css";

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const {
    title = `Haider-sama`,
    description = `Hi! This is Haider. Mechatronics Engineer, Full Stack Developer and a Game Engine Dev 
    who has a passion for building stuff, martial arts and Dragon Ball.`,
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <meta
            name="keywords"
            content=`web development, website design, responsive websites, business websites, 
            SEO websites, web agency, custom websites, mechatronics, engine development, full
            stack engineer, AI/ML engineer`
        />
        <meta name="author" content="Haider Ali" />
        <meta name="robots" content="index, follow" />
        <meta name="theme-color" content="#ffffff" />

        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={Astro.url.href} />
        <meta property="og:site_name" content="Y3D Technologies" />
        <meta property="og:image" content="/og-image.jpg" />

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <link rel="canonical" href={Astro.url.href} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

        <title>{title}</title>
    </head>

    <body class="min-h-screen flex flex-col bg-primary">
        <div
            class="mx-auto flex w-full max-w-4xl flex-1 flex-col border-x border-b
            border-gray-400 bg-gray-100"
        >
            <Header />

            <main class="flex-1 p-8 space-y-8">
                <slot />
            </main>
        </div>

        <Footer />
    </body>
</html>
