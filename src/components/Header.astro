---
const links = [
    { href: "/", label: "Home" },
    { href: "/projects", label: "Projects" },
    { href: "/about", label: "About" },
    { href: "/contact", label: "Contact" },
    { href: "/blog", label: "Blog" }
];
---

<header class="text-center py-16 bg-cover bg-center bg-[url('/images/land.jpg')]">
    <h1 class="text-5xl font-bold text-white pixel-shadow">Haider-sama</h1>
</header>

<nav
    class="flex justify-center border-y border-gray-300 bg-gray-100 divide-x divide-gray-300"
>
    {
        links.map((link) => (
            <a href={link.href} class="px-4 py-2 hover:bg-gray-200 
            first:border-l first:border-gray-300 last:border-r last:border-gray-300">
                {link.label}
            </a>
        ))
    }
</nav>
