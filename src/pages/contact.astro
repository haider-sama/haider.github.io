---
import MainLayout from "@/layouts/MainLayout.astro";
---

<MainLayout>
    <section class="border border-gray-300 bg-secondary p-8">
        <h1 class="mb-4 text-3xl font-bold">Contact</h1>

        <p class="mb-8 text-base text-gray-600">
            Whether you want to discuss anything, need any help
            or just want to say Hi! - feel free to reach out.
        </p>

        <div class="space-y-4">
            <div class="flex items-center gap-4 border-b border-gray-300 pb-4">
                <img
                    src="/images/social/gmail.png"
                    alt="Email"
                    class="h-8 w-8"
                />

                <div>
                    <h2 class="font-semibold">Email</h2>

                    <a
                        href="mailto:vegeta.khan2000@gmail.com"
                        class="text-blue-500 hover:underline"
                    >
                        vegeta.khan2000@gmail.com
                    </a>
                </div>
            </div>

            <div class="flex items-center gap-4 border-b border-gray-300 pb-4">
                <img
                    src="/images/social/github.png"
                    alt="GitHub"
                    class="h-8 w-8"
                />

                <div>
                    <h2 class="font-semibold">GitHub</h2>

                    <p class="text-sm text-gray-600">
                        Source code, experiments and personal projects.
                    </p>

                    <a
                        href="https://github.com/haider-sama"
                        target="_blank"
                        class="text-blue-500 hover:underline"
                    >
                        github.com/haider-sama
                    </a>
                </div>
            </div>

            <div class="flex items-center gap-4 border-b border-gray-300 pb-4">
                <img
                    src="/images/social/linkedin.png"
                    alt="LinkedIn"
                    class="h-8 w-8"
                />

                <div>
                    <h2 class="font-semibold">LinkedIn</h2>

                    <p class="text-sm text-gray-600">
                        Professional experience and career updates.
                    </p>

                    <a
                        href="https://linkedin.com/in/haider-sama"
                        target="_blank"
                        class="text-blue-500 hover:underline"
                    >
                        linkedin.com/in/haider-sama
                    </a>
                </div>
            </div>

            <div class="flex items-center gap-4 border-b border-gray-300 pb-4">
                <img
                    src="/images/social/steam.png"
                    alt="Steam"
                    class="h-8 w-8"
                />

                <div>
                    <h2 class="font-semibold">Steam</h2>

                    <p class="text-sm text-gray-600">
                        I mostly play CS2 here.
                    </p>

                    <a
                        href="https://steamcommunity.com/id/haider-sama"
                        target="_blank"
                        class="text-blue-500 hover:underline"
                    >
                        steamcommunity.com/id/haider-sama
                    </a>
                </div>
            </div>

            <div class="flex items-center gap-4 border-b border-gray-300 pb-4">
                <img
                    src="/images/social/gamebanana.png"
                    alt="GameBanana"
                    class="h-8 w-8"
                />

                <div>
                    <h2 class="font-semibold">GameBanana</h2>

                    <p class="text-sm text-gray-600">
                        My older Source Engine maps and modding work.
                    </p>

                    <a
                        href="https://gamebanana.com/members/2361251"
                        target="_blank"
                        class="text-blue-500 hover:underline"
                    >
                        View Profile
                    </a>
                </div>
            </div>

            <div class="flex items-center gap-4 pt-2">
                <img
                    src="/images/social/resume.png"
                    alt="Resume"
                    class="h-8 w-8"
                />

                <div>
                    <h2 class="font-semibold">Résumé</h2>

                    <p class="text-sm text-gray-600">
                        Available for anyone interested... I only charge{" "}
                        <strong>$5,000,000</strong>. 😉
                    </p>

                    <a
                        href="/resume.pdf"
                        target="_blank"
                        class="text-blue-500 hover:underline"
                    >
                        Download Resume
                    </a>
                </div>
            </div>
        </div>
    </section>
</MainLayout>
